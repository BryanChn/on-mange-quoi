// Schéma de données du MVP · Décider
// Format DBML : coller dans https://dbdiagram.io pour voir le diagramme.
// Source de vérité de la conception ; les migrations SQL (supabase/migrations/) l'implémentent.

// ─── Comptes ─────────────────────────────────────────────

// Infos publiques d'un compte. Le compte lui-même (email, connexion OTP)
// est géré par Supabase Auth dans auth.users : on ne le duplique pas (RGPD).
// Un invité anonyme (V1) a aussi une ligne dans auth.users, donc un profil.
Table profiles {
  id           uuid        [pk, ref: - auth.users.id, note: 'ON DELETE CASCADE']
  display_name varchar(30) [not null, note: 'nom affiché dans le groupe, ex. "Maman"']
  created_at   timestamptz [not null, default: `now()`]
}

// ─── Groupes ─────────────────────────────────────────────

// Groupe permanent (ex. "Famille"). Chaque repas = une nouvelle session de vote.
Table groups {
  id          uuid        [pk, default: `gen_random_uuid()`]
  name        varchar(50) [not null]
  owner_id    uuid        [not null, ref: > profiles.id, note: 'ON DELETE RESTRICT : transférer l’ownership avant de supprimer le compte']
  invite_code varchar(12) [not null, unique, note: 'aléatoire et imprévisible, généré côté serveur, régénérable par l’owner']
  created_at  timestamptz [not null, default: `now()`]
}

// Appartenance d'un profil à un groupe. L'owner y figure aussi.
Table group_members {
  group_id   uuid        [ref: > groups.id,   note: 'ON DELETE CASCADE']
  profile_id uuid        [ref: > profiles.id, note: 'ON DELETE CASCADE']
  joined_at  timestamptz [not null, default: `now()`, note: 'transfert d’ownership : au membre le plus ancien']

  indexes {
    (group_id, profile_id) [pk]
  }
}

// ─── Vote ────────────────────────────────────────────────

Enum session_status {
  open
  closed
}

// Façon dont le gagnant a été désigné (règles du vote, CLAUDE.md).
Enum decision_method {
  vote
  tirage
  organisateur
}

Table vote_sessions {
  id                 uuid            [pk, default: `gen_random_uuid()`]
  group_id           uuid            [not null, ref: > groups.id, note: 'ON DELETE CASCADE']
  organizer_id       uuid            [ref: > profiles.id, note: 'ON DELETE SET NULL : on garde l’historique']
  status             session_status  [not null, default: 'open']
  winner_proposal_id uuid            [ref: > proposals.id, note: 'null tant que la session est ouverte ; doit appartenir à cette session']
  decided_by         decision_method [note: 'null tant que la session est ouverte']
  created_at         timestamptz     [not null, default: `now()`]
  closed_at          timestamptz

  Note: 'CHECK : status = closed <=> winner_proposal_id, decided_by et closed_at renseignés'
}

// Plat soumis au vote, en texte libre (pas de catalogue au MVP).
Table proposals {
  id          uuid        [pk, default: `gen_random_uuid()`]
  session_id  uuid        [not null, ref: > vote_sessions.id, note: 'ON DELETE CASCADE']
  name        varchar(60) [not null]
  proposed_by uuid        [ref: > profiles.id, note: 'ON DELETE SET NULL']
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (session_id, name) [unique, note: 'pas deux fois le même plat dans une session']
  }
}

// Une ligne = "ce profil a coché ce plat". Pas de compteur : le score = COUNT(*).
// Décocher = supprimer sa ligne (tant que la session est ouverte).
Table votes {
  proposal_id uuid        [ref: > proposals.id, note: 'ON DELETE CASCADE']
  profile_id  uuid        [ref: > profiles.id,  note: 'ON DELETE CASCADE']
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (proposal_id, profile_id) [pk, note: 'un vote max par personne et par plat']
  }
}
