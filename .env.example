# Copier ce fichier en .env et remplir les valeurs (Supabase > Project Settings > API).
# Les variables EXPO_PUBLIC_* sont embarquées dans l'app : elles sont lisibles par n'importe qui.
# N'y mettre que l'URL et la clé publique (anon / publishable), JAMAIS la clé service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
