{
  "expo": {
    "name": "On mange quoi ?",
    "slug": "on-mange-quoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/omq-icon.png",
    "scheme": "onmangequoi",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.bryanchn.onmangequoi",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1E2",
        "foregroundImage": "./assets/images/omq-android-foreground.png",
        "monochromeImage": "./assets/images/omq-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF1E2",
          "image": "./assets/images/omq-splash.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#161514",
            "image": "./assets/images/omq-splash-nuit.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7034dd8e-b1ce-49ec-a974-1238e406f711"
      }
    },
    "owner": "bryanchns-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7034dd8e-b1ce-49ec-a974-1238e406f711"
    }
  }
}
